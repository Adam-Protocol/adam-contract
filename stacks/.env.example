# Stacks Deployer Private Key (mnemonic phrase)
STACKS_DEPLOYER_PRIVATE_KEY="your twenty four word mnemonic phrase here"

# Network (testnet or mainnet)
STACKS_NETWORK="testnet"

# Treasury address for fee collection (defaults to deployer if not set)
STACKS_TREASURY_ADDRESS=""

# Backend service address for rate-setter role (optional)
STACKS_BACKEND_ADDRESS=""

# Transaction fee in basis points (50 = 0.5%)
SWAP_FEE_BPS="50"

# Exchange rates (in 1e6 precision - 6 decimals)
# Format: rate = real_rate × 1,000,000
# Example: 1 USDC = 1383.05 ADNGN → 1383.05 × 1e6 = 1383050000

# USDC <-> ADUSD (1:1 peg)
RATE_USDC_ADUSD="1000000"
RATE_ADUSD_USDC="1000000"

# USDC <-> ADNGN (1 USDC = 1383.05 ADNGN)
RATE_USDC_ADNGN="1383050000"
RATE_ADNGN_USDC="723"

# USDC <-> ADKES (1 USDC = 129.32 ADKES)
RATE_USDC_ADKES="129320000"
RATE_ADKES_USDC="7733"

# USDC <-> ADGHS (1 USDC = 10.91 ADGHS)
RATE_USDC_ADGHS="10910000"
RATE_ADGHS_USDC="91660"

# USDC <-> ADZAR (1 USDC = 17.08 ADZAR)
RATE_USDC_ADZAR="17080000"
RATE_ADZAR_USDC="58548"

# Direct ADUSD to other tokens (for swap operations)
RATE_ADUSD_ADNGN="1383050000"
RATE_ADNGN_ADUSD="723"
RATE_ADUSD_ADKES="129320000"
RATE_ADKES_ADUSD="7733"
RATE_ADUSD_ADGHS="10910000"
RATE_ADGHS_ADUSD="91660"
RATE_ADUSD_ADZAR="17080000"
RATE_ADZAR_ADUSD="58548"
