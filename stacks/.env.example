# Stacks Deployer Configuration
STACKS_DEPLOYER_PRIVATE_KEY="your twenty four word mnemonic phrase here"

# Treasury address for fee collection (defaults to deployer if not set)
STACKS_TREASURY_ADDRESS=""

# Backend service address for rate-setter role (optional)
STACKS_BACKEND_ADDRESS=""

# Initial exchange rates (in 1e18 precision)
# USDC <-> ADUSD (1:1)
RATE_USDC_ADUSD="1000000000000000000"
RATE_ADUSD_USDC="1000000000000000000"

# USDC <-> ADNGN (1 USD = 1500 NGN)
RATE_USDC_ADNGN="1500000000000000000000"
RATE_ADNGN_USDC="666666666666666666"

# USDC <-> ADKES (1 USD = 150 KES)
RATE_USDC_ADKES="150000000000000000000"
RATE_ADKES_USDC="6666666666666666"

# USDC <-> ADGHS (1 USD = 15 GHS)
RATE_USDC_ADGHS="15000000000000000000"
RATE_ADGHS_USDC="66666666666666666"

# USDC <-> ADZAR (1 USD = 18 ZAR)
RATE_USDC_ADZAR="18000000000000000000"
RATE_ADZAR_USDC="55555555555555555"

# Transaction fee in basis points (50 = 0.5%)
SWAP_FEE_BPS="50"

# Network (testnet or mainnet)
STACKS_NETWORK="testnet"
